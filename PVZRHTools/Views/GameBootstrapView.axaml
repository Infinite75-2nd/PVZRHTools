<u:ReactiveUrsaWindow x:TypeArguments="vm:GameBootstrapViewModel" xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:vm="using:PVZRHTools.ViewModels"
                      xmlns:v="using:PVZRHTools.Views"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:u="https://irihi.tech/ursa"
                      xmlns:converters="using:PVZRHTools.Converters"
                      xmlns:utils="using:PVZRHTools.Utils"
                      mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                      x:Class="PVZRHTools.Views.GameBootstrapView"
                      x:DataType="vm:GameBootstrapViewModel"
                      x:CompileBindings="True"
                      IsFullScreenButtonVisible="False"
                      CanMaximize="False"
                      Background="{DynamicResource SemiColorAIBackgroundBottomActive}"
                      Title="PVZRHTools by Infinite75">

    <u:ReactiveUrsaWindow.RightContent>
        <StackPanel Orientation="Horizontal">
            <u:IconButton Icon="{DynamicResource SemiIconGithubLogo}"
                          Command="{Binding OpenGithubCommand}"
                          Theme="{DynamicResource BorderlessIconButton}"
                          Classes="Tertiary" />
            <u:ThemeToggleButton IsThreeState="True" Mode="Controller" />
        </StackPanel>
    </u:ReactiveUrsaWindow.RightContent>

    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Closing">
            <InvokeCommandAction Command="{Binding ClosingCommand}" />
        </EventTriggerBehavior>
    </Interaction.Behaviors>

    <Border
        Padding="1"
        Theme="{DynamicResource CardBorder}">
        <Panel>
            <Panel.Styles>
                <Style Selector="Grid.Blur">
                    <Setter Property="Effect" Value="blur(10)" />
                </Style>
            </Panel.Styles>
            <Grid Classes.Blur="{Binding $parent[u:UrsaWindow].(u:OverlayDialogHost.IsInModalStatus)}"
                  ColumnDefinitions="Auto, *" ColumnSpacing="10">
                <u:NavMenu
                    Name="MainMenu"
                    Classes="enable_animation"
                    u:SizeAnimationHelper.CreateAnimation="{x:Static utils:NavMenuWidthAnimation.Generator}"
                    ExpandWidth="200"
                    ItemsSource="{Binding MenuItems}"
                    HeaderBinding="{Binding MenuHeader}"
                    IconBinding="{Binding MenuIcon}"
                    CommandBinding="{Binding NavigateCommand}"
                    Margin="10,10,0,0">
                    <u:NavMenu.Header>
                        <Grid HorizontalAlignment="Center" ColumnDefinitions="Auto, Auto">
                            <Panel
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Cursor="Hand"
                                Margin="4,12"
                                ToolTip.Tip="展开/收起侧边栏"
                                u:NavMenu.CanToggle="True">
                                <PathIcon
                                    Width="24"
                                    Height="24"
                                    Data="{DynamicResource SemiIconBox}" />
                            </Panel>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Classes="H3"
                                Text="PVZRHTools"
                                Theme="{DynamicResource TitleTextBlock}"
                                IsVisible="{Binding !#MainMenu.IsHorizontalCollapsed}" />
                        </Grid>
                    </u:NavMenu.Header>
                    <u:NavMenu.IconTemplate>
                        <DataTemplate x:DataType="x:String">
                            <PathIcon Width="16"
                                      Height="16"
                                      Data="{Binding Converter={x:Static converters:ResourceKeyToGeometryConverter.Instance}}" />
                        </DataTemplate>
                    </u:NavMenu.IconTemplate>
                    <u:NavMenu.HeaderTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock HorizontalAlignment="Left"
                                       Text="{Binding}"
                                       Theme="{DynamicResource TitleTextBlock}"
                                       Classes="H6"
                                       Foreground="{DynamicResource SemiAIGeneral8}" />
                        </DataTemplate>
                    </u:NavMenu.HeaderTemplate>
                    <u:NavMenu.Footer>
                        <v:ModifierAuthorsView DataContext="{Binding ModifierAuthors}"
                                               IsVisible="{Binding !#MainMenu.IsHorizontalCollapsed}" />
                    </u:NavMenu.Footer>
                </u:NavMenu>
                <ScrollViewer Grid.Column="1"
                              Margin="0,30,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding CurrentPage}">
                        <ContentControl.ContentTemplate>
                            <vm:ViewLocator />
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </Panel>
    </Border>
</u:ReactiveUrsaWindow>