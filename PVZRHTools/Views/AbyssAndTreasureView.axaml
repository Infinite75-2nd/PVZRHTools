<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PVZRHTools.ViewModels"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="950"
             x:Class="PVZRHTools.Views.AbyssAndTreasureView"
             x:CompileBindings="True"
             x:DataType="vm:AbyssAndTreasureViewModel">
    <UserControl.Styles>
        <Style Selector="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Theme" Value="{DynamicResource TagLabel}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="u|NumericUpDown">
            <Setter Property="MinWidth" Value="100" />
        </Style>
    </UserControl.Styles>
    
    <WrapPanel Orientation="Vertical">
        <Border>
            <StackPanel Orientation="Vertical">
                <u:Divider Content="冒险秘境模式修改"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="修改木头抽奖券"
                            Command="{Binding SetAbyssWoodenTicketCommand}"/>
                    <u:NumericIntUpDown
                        Minimum="0"
                        Value="{Binding AbyssWoodenTicket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="修改白银抽奖券"
                            Command="{Binding SetAbyssSilverTicketCommand}"/>
                    <u:NumericIntUpDown
                        Minimum="0"
                        Value="{Binding AbyssSilverTicket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="修改黄金抽奖券"
                            Command="{Binding SetAbyssGoldTicketCommand}"/>
                    <u:NumericIntUpDown
                        Minimum="0"
                        Value="{Binding AbyssGoldTicket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="修改钻石抽奖券"
                            Command="{Binding SetAbyssDiamondTicketCommand}"/>
                    <u:NumericIntUpDown
                        Minimum="0"
                        Value="{Binding AbyssDiamondTicket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border>
            <StackPanel Orientation="Vertical">
                <u:Divider Content="神秘模式修改"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="修改资产数"
                            Command="{Binding TreasureSetMoneyCommand}"/>
                    <u:NumericIntUpDown
                        Minimum="0"
                        Step="100"
                        Value="{Binding TreasureMoney, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="修改最大关卡时长" IsChecked="{Binding TreasureMaxTimeEnabled, Mode=TwoWay}"/>
                    <u:NumericIntUpDown
                        Value="{Binding TreasureMaxTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Minimum="1"
                        Step="10"
                        InnerRightContent="秒"/>
                    <Button Content="现有卡片满库存"
                            Command="{Binding TreasureFillCardCommand}"/>
                    <u:PopConfirm PopupHeader="确定进行此修改？"
                                  HorizontalAlignment="Left"
                                  PopupContent="此修改将不可逆"
                                  Placement="BottomEdgeAlignedRight"
                                  ConfirmCommand="{Binding TreasureSellAllCardsCommand}">
                        <Button Content="一键出售全部植物"/>
                    </u:PopConfirm>
                    <u:PopConfirm PopupHeader="确定进行此修改？"
                                  HorizontalAlignment="Left"
                                  PopupContent="此修改将不可逆"
                                  Placement="BottomEdgeAlignedRight"
                                  ConfirmCommand="{Binding TreasureFillWareCommand}">
                        <Button Content="一键获得全植物卡片"/>
                    </u:PopConfirm>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="大幅提高红卡概率"
                              IsChecked="{Binding TreasureAllRedCard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="仓库免费升级" IsChecked="{Binding TreasureFreeUpgrade, Mode=TwoWay}"/>
                    <CheckBox Content="取消撤离等待时间限制" IsChecked="{Binding TreasureFreeWithdraw, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border>
            <StackPanel Orientation="Vertical" Spacing="5">
                <u:Divider Content="花园修改"/>
                <Label Content="部分修改需要操作完重进花园"
                       Classes="Colorful Gradient" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="修改钱数"
                            Command="{Binding ZenGardenSetMoneyCommand}"/>
                    <u:NumericIntUpDown
                        Value="{Binding ZenGardenMoney,Mode=TwoWay}"/>
                    <Button Content="修改火红莲币数"
                            Command="{Binding ZenGardenSetCoinCommand}"/>
                    <u:NumericIntUpDown
                        Value="{Binding ZenGardenCoin,Mode=TwoWay}"/>
                    <Button Content="获得植物"
                            Command="{Binding ZenGardenGetPlantCommand}"/>
                    <ComboBox ItemsSource="{Binding InitDataService.InitData.Plants}"
                              SelectedValue="{Binding ZenGardenPlantType,Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Value}"
                              SelectedValueBinding="{Binding Key}"/>
                    <u:PopConfirm PopupHeader="确定进行此修改？"
                                  HorizontalAlignment="Left"
                                  PopupContent="此修改将不可逆"
                                  Placement="BottomEdgeAlignedRight"
                                  ConfirmCommand="{Binding ZenGardenRemoveAllPlantsCommand}">
                        <Button Content="清除所有花园植物"/>
                    </u:PopConfirm>
                    <u:PopConfirm PopupHeader="确定进行此修改？"
                                  HorizontalAlignment="Left"
                                  PopupContent="此修改将不可逆"
                                  Placement="BottomEdgeAlignedRight"
                                  ConfirmCommand="{Binding ZenGardenGetAllPlantsCommand}">
                        <Button Content="花园一键全植物"/>
                    </u:PopConfirm>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="一键全部浇满水"
                            Command="{Binding ZenGardenWaterAllPlantsCommand}"/>
                    <Button Content="植物全部长大"
                            Command="{Binding ZenGardenAllPlantsFullyGrownCommand}"/>
                    <Button Content="植物全部冒金光"
                            Command="{Binding ZenGardenAllPlantsFullLoveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border>
            <StackPanel Orientation="Vertical">
                <u:Divider Content="星辉冒险修改"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="修改普通难度星星数"
                            Command="{Binding SetStarAdvStarCommand}"/>
                    <u:NumericIntUpDown
                        Minimum="0"
                        Value="{Binding StarAdvStar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="修改困难难度星星数"
                            Command="{Binding SetStarAdvStarHardCommand}"/>
                    <u:NumericIntUpDown
                        Minimum="0"
                        Value="{Binding StarAdvStarHard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="星辉冒险词条免费点亮"
                              IsChecked="{Binding StarAdvFreeBuff, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </WrapPanel>
</UserControl>
