<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PVZRHTools.ViewModels"
             xmlns:v="using:PVZRHTools.Views"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="900"
             x:Class="PVZRHTools.Views.AboutView"
             x:CompileBindings="True"
             x:DataType="vm:AboutViewModel">

    <UserControl.Styles>
        <Style Selector="Grid > Border">
            <Setter Property="Theme" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="5" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiAIGeneral3}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="u|DualBadge">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
        <Style Selector="TextBlock.FieldValue">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*, *, *"
          RowDefinitions="*, *"
          ColumnSpacing="8"
          RowSpacing="8">
        <Border Grid.Row="0" Grid.Column="0">
            <StackPanel Spacing="8">
                <u:Divider Content="项目信息" />
                <TextBlock Text="{Binding ProjectName}"
                           Classes="H4"
                           Theme="{StaticResource TitleTextBlock}"
                           Foreground="{DynamicResource SemiColorAIGeneralActive}" />
                <TextBlock Text="{Binding ProjectDescription}" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="FieldLabel" Text="适配游戏" />
                    <TextBlock Classes="FieldValue H6"
                               Theme="{StaticResource TitleTextBlock}"
                               Text="{Binding GameVersion}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="FieldLabel" Text="窗口端版本" />
                    <TextBlock Classes="FieldValue H6"
                               Theme="{StaticResource TitleTextBlock}"
                               Text="{Binding ModifierVersion}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="FieldLabel" Text="ToolMod" />
                    <TextBlock Classes="FieldValue H6"
                               Theme="{StaticResource TitleTextBlock}"
                               Text="{Binding ToolModVersion}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="FieldLabel" Text="开源协议" />
                    <TextBlock Classes="FieldValue H6"
                               Theme="{StaticResource TitleTextBlock}"
                               Text="{Binding LicenseName}" />
                    <u:IconButton Icon="{DynamicResource SemiIconForwardStroked}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/Infinite75-2nd/PVZRHTools/blob/master/LICENSE" />
                </StackPanel>
                <u:IconButton Content="GitHub 仓库"
                              Icon="{DynamicResource SemiIconGithubLogo}"
                              Classes="Primary"
                              Theme="{DynamicResource SolidIconButton}"
                              Command="{Binding OpenUrlCommand}"
                              CommandParameter="https://github.com/Infinite75-2nd/PVZRHTools" />
                <u:IconButton Content="Bug反馈 / 新功能建议"
                              Icon="{DynamicResource SemiIconCommentStroked}"
                              Classes="Warning"
                              Theme="{DynamicResource SolidIconButton}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <Image MaxWidth="260"
                                   MaxHeight="360"
                                   Stretch="Uniform"
                                   Source="avares://PVZRHTools/Assets/QQFeedback.png" />
                        </Flyout>
                    </Button.Flyout>
                </u:IconButton>
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1">
            <v:ModifierAuthorsView DataContext="{Binding Authors}" />
        </Border>

        <Border Grid.Row="0" Grid.Column="2">
            <StackPanel Spacing="8">
                <u:Divider Content="技术栈" />
                <TextBlock Text="窗口端 (PVZRHTools)" Classes="H6" Theme="{StaticResource TitleTextBlock}" />
                <WrapPanel>
                    <u:DualBadge Header=".NET" Content="10" Classes="Primary" />
                    <u:DualBadge Header="Avalonia" Content="12" Classes="Primary" />
                    <u:DualBadge Header="Native AOT" Content="Release" Classes="Success" />
                </WrapPanel>
                <WrapPanel>
                    <u:DualBadge Header="MVVM" Content="ReactiveUI" Classes="Secondary" />
                    <u:DualBadge Header="UI" Content="Semi + Ursa" Classes="Tertiary" />
                </WrapPanel>
                <u:Divider />
                <TextBlock Text="模组端 (ToolMod)" Classes="H6" Theme="{StaticResource TitleTextBlock}" />
                <WrapPanel>
                    <u:DualBadge Header=".NET" Content="6" Classes="Primary" />
                    <u:DualBadge Header="BepInEx" Content="IL2CPP" Classes="Warning" />
                </WrapPanel>
                <WrapPanel>
                    <u:DualBadge Header="Harmony" Content="Patch" Classes="Secondary" />
                    <u:DualBadge Header="ToolData" Content="管道同步" Classes="Tertiary" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0">
            <StackPanel Spacing="4">
                <u:Divider Content="窗口端依赖库" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="Avalonia 12.1.3" />
                    <u:IconButton Content="MIT"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/AvaloniaUI/Avalonia" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="Semi.Avalonia 12.1.0.1" />
                    <u:IconButton Content="MIT"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/irihitech/Semi.Avalonia" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="Ursa 2.2.0" />
                    <u:IconButton Content="MIT"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/irihitech/Ursa.Avalonia" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="ReactiveUI 23.2.28" />
                    <u:IconButton Content="MIT"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/reactiveui/ReactiveUI" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="Xaml.Behaviors 12.0.7" />
                    <u:IconButton Content="MIT"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/wieslawsoltes/Xaml.Behaviors" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="SharpCompress 0.50.4" />
                    <u:IconButton Content="MIT"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/adamhathcock/sharpcompress" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="Mono.Cecil 0.11.6" />
                    <u:IconButton Content="MIT"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/jbevain/cecil" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="StaticViewLocator 0.7.0" />
                    <u:IconButton Content="MIT"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/wieslawsoltes/StaticViewLocator" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1">
            <StackPanel Spacing="4">
                <u:Divider Content="模组端依赖库" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="BepInEx Unity IL2CPP" />
                    <u:IconButton Content="LGPL-2.1"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/BepInEx/BepInEx" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="Harmony (0Harmony)" />
                    <u:IconButton Content="MIT"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/pardeike/Harmony" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="168" Text="Il2CppInterop" />
                    <u:IconButton Content="LGPL-3.0"
                                  Icon="{DynamicResource SemiIconGithubLogo}"
                                  Classes="Tertiary"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/BepInEx/Il2CppInterop" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2">
            <StackPanel Spacing="8">
                <u:Divider Content="上游项目致谢" />
                <TextBlock Text="感谢两位大佬在我跑路了的一年里的接手维护"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="140" Text="PVZRHTools" />
                    <TextBlock VerticalAlignment="Center" Text="CarefreeSongs712  ·  Apache-2.0" />
                    <u:IconButton Icon="{DynamicResource SemiIconGithubLogo}"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Classes="Tertiary"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/CarefreeSongs712/PVZRHTools" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="FieldLabel" MinWidth="140" Text="PVZRHTools-new" />
                    <TextBlock VerticalAlignment="Center" Text="MKHkro1  ·  Apache-2.0" />
                    <u:IconButton Icon="{DynamicResource SemiIconGithubLogo}"
                                  Theme="{DynamicResource BorderlessIconButton}"
                                  Classes="Tertiary"
                                  Command="{Binding OpenUrlCommand}"
                                  CommandParameter="https://github.com/MKHkro1/PVZRHTools-new" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
